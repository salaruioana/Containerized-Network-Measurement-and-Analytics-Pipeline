# Copy to .env before running:  cp .env.example .env
# DEMO values in valid formats, so the stack comes up locally out of the box.
# Regenerate before any real use:
#   GARAGE_RPC_SECRET / S3_SECRET_KEY : openssl rand -hex 32
#   GARAGE_ADMIN_TOKEN                : openssl rand -hex 16
#   S3_ACCESS_KEY                     : "GK" + openssl rand -hex 12
#
# Nothing here is read by the code directly. The code reads the environment,
# your docker-compose.yml is what puts these into it. The graded stack runs
# with different values, so anything you hardcode works only on your machine.

# Garage cluster secrets
GARAGE_RPC_SECRET=cafebabecafebabecafebabecafebabecafebabecafebabecafebabecafebabe
GARAGE_ADMIN_TOKEN=cafebabecafebabecafebabecafebabe

# S3 credentials, shared by all four services
S3_ACCESS_KEY=GKdeadbeefdeadbeefdeadbeef
S3_SECRET_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef

# RabbitMQ. The services connect with these; create the broker with them too.
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=aic
RABBITMQ_PASSWORD=aic-demo-rabbitmq-pw

# DEBUG adds per-message and per-lookup tracing, once you log any.
LOG_LEVEL=INFO
